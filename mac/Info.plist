<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>DeepSeek Harness</string>
	<key>CFBundleDisplayName</key>
	<string>DeepSeek Harness</string>
	<key>CFBundleExecutable</key>
	<string>DeepSeekHarness</string>
	<key>CFBundleIdentifier</key>
	<string>local.deepseek-harness.shell</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>
	<!-- Two copies fight over one server, and the copy that owns the server
	     kills it on quit — so a stray second launch closes the first window. -->
	<key>LSMultipleInstancesProhibited</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- Voice input: dictation into the composer. Both strings are required —
	     macOS terminates the app on the first request without them. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>用于把你说的话转成文字，填入输入框。</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>用于把麦克风里的语音识别成文字。</string>
	<!-- Files and Folders. Without these strings, macOS still prompts but
	     often forgets the grant, so Desktop/Documents/Downloads come back
	     every launch — especially after a rebuild. -->
	<key>NSDesktopFolderUsageDescription</key>
	<string>知识库和资料可能在桌面上，需要读取这些文件才能建索引和提问。</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>知识库和资料可能在「文稿」里，需要读取这些文件才能建索引和提问。</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>知识库和资料可能在「下载」里，需要读取这些文件才能建索引和提问。</string>
	<key>NSRemovableVolumesUsageDescription</key>
	<string>如果你把资料放在外接磁盘上，需要读取这些文件才能建索引和提问。</string>
	<key>NSNetworkVolumesUsageDescription</key>
	<string>如果你把资料放在网络磁盘上，需要读取这些文件才能建索引和提问。</string>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>
	<!-- WKWebView talks to the loopback server over plain HTTP. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>127.0.0.1</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
